<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup>
		<Version>1.0.1</Version>
		<Authors>David Whelan</Authors>
		<Description>A strongly‑typed HTML DSL for Firelight, offering a clean F# syntax for Lit components and a foundation for building custom DSL libraries.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/DavidWhelan/Firelight.Html</PackageProjectUrl>
		<RepositoryUrl>https://github.com/DavidWhelan/Firelight.Html</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>fable;fsharp;lit;html;dsl;web-components</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../../README.md" Pack="true" PackagePath="/" />
	</ItemGroup>

	<!-- Add source files to "fable" folder in Nuget package -->
	<ItemGroup>
		<Content Include="*.fsproj; *.fs" PackagePath="fable\" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="Types.fs" />
		<Compile Include="Renderer.fs" />
		<Compile Include="Dsl.fs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Firelight" Version="0.3.0" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Update="FSharp.Core" Version="11.0.101" />
	</ItemGroup>

</Project>
